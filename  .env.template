# =============================================================================
# .env.template — A/B Testing & Statistical Inference Dashboard
# =============================================================================
#
# HOW TO USE
# ──────────
#   1. Copy this file to .env in the project root:
#        cp .env.template .env
#
#   2. Edit .env and replace any value you want to override.
#      Lines starting with # are comments — they are ignored.
#
#   3. NEVER commit .env to version control.
#      It is already listed in .gitignore.
#
#   4. All variables map 1-to-1 to fields in config/settings.py.
#      pydantic-settings reads them automatically on startup.
#
#   5. Environment variables always override .env file values.
#      Useful for CI/CD:
#        APP_ENV=production streamlit run app.py
#
# VARIABLE NAMING CONVENTION
# ──────────────────────────
#   Pydantic BaseSettings maps env vars to fields using uppercase.
#   Field `default_alpha` in Settings  →  env var APP_ENV=...  No.
#   Field `app_env`       in Settings  →  env var APP_ENV=development  ✓
#   (Underscore in field name becomes underscore in env var name.)
#
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# Controls basic runtime behaviour of the Streamlit dashboard.
# -----------------------------------------------------------------------------

# Runtime environment.
# Controls logging verbosity, debug helpers, and error display.
# Allowed values: development | staging | production
APP_ENV=development

# Port Streamlit listens on.
# Override if 8501 is already in use on your machine.
# CLI equivalent: streamlit run app.py --server.port 8502
APP_PORT=8501

# Title displayed in the browser tab and Streamlit page config.
APP_TITLE=A/B Testing & Statistical Inference Dashboard


# -----------------------------------------------------------------------------
# STATISTICAL DEFAULTS
# These become the initial slider values shown in the sidebar when the
# dashboard first loads. Users can always change them interactively.
#
# Validation rules (enforced by pydantic — startup will fail if violated):
#   DEFAULT_ALPHA          : 0.001 ≤ value ≤ 0.20
#   DEFAULT_POWER          : 0.50  ≤ value ≤ 0.99
#   DEFAULT_MDE            : 0.01  ≤ value ≤ 0.50
#   MONTE_CARLO_SAMPLES    : 1000  ≤ value ≤ 1,000,000
# -----------------------------------------------------------------------------

# Significance level α (Type-I error rate).
# Industry standard: 0.05 (5% false positive rate).
# Stricter experiments (medical, financial): use 0.01.
DEFAULT_ALPHA=0.05

# Target statistical power (1 − β, i.e. 1 − Type-II error rate).
# Probability of detecting a true effect when one exists.
# Industry minimum: 0.80. Higher-stakes experiments: 0.90.
DEFAULT_POWER=0.80

# Minimum Detectable Effect — expressed as a relative fraction of baseline.
# 0.10 means: detect a 10% relative lift (e.g. 10.0% CVR → 11.0% CVR).
# Smaller MDE requires larger sample sizes.
DEFAULT_MDE=0.10

# Number of Monte Carlo samples for Bayesian P(B > A) estimation.
# More samples → lower variance in P(B>A) estimate → slower computation.
#   10000   — fast, ~±1% precision  (good for development)
#   50000   — balanced (recommended default)
#   100000  — high precision, ~±0.3% (recommended for production decisions)
MONTE_CARLO_SAMPLES=50000


# -----------------------------------------------------------------------------
# LOGGING
# Uses loguru for structured logging throughout src/.
# Logs are written to both stderr (terminal) and the file below.
# -----------------------------------------------------------------------------

# Log verbosity level.
# Allowed values: DEBUG | INFO | WARNING | ERROR | CRITICAL
#   DEBUG    — prints every function entry/exit, useful during development
#   INFO     — prints key milestones (test results, sample sizes computed)
#   WARNING  — prints only anomalies (SRM detected, small sample warnings)
#   ERROR    — prints only failures
LOG_LEVEL=INFO

# Path to the log file (relative to project root).
# Directory is created automatically if it does not exist.
# Set to an empty string to disable file logging:
#   LOG_FILE=
LOG_FILE=logs/app.log


# -----------------------------------------------------------------------------
# DATA PATHS
# Relative paths from the project root.
# Used by SyntheticDataGenerator and any CSV export features.
# -----------------------------------------------------------------------------

# Directory where sample / demo datasets are stored.
# SyntheticDataGenerator writes generated CSVs here when export is triggered.
DATA_DIR=data/samples

# Directory where experiment result exports are written.
# Dashboard "Download results" buttons save files here.
EXPORT_DIR=data/exports


# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================
# Copy the relevant block into your actual .env and uncomment it.
#
# ── DEVELOPMENT ──────────────────────────────────────────────────────────────
# APP_ENV=development
# LOG_LEVEL=DEBUG
# MONTE_CARLO_SAMPLES=10000          # faster iteration
# DEFAULT_ALPHA=0.05
#
# ── STAGING ──────────────────────────────────────────────────────────────────
# APP_ENV=staging
# LOG_LEVEL=INFO
# MONTE_CARLO_SAMPLES=50000
# DEFAULT_ALPHA=0.05
#
# ── PRODUCTION ───────────────────────────────────────────────────────────────
# APP_ENV=production
# LOG_LEVEL=WARNING                  # reduce log noise in prod
# MONTE_CARLO_SAMPLES=100000         # higher precision for real decisions
# DEFAULT_ALPHA=0.05
# DEFAULT_POWER=0.90                 # stricter power requirement
# =============================================================================
